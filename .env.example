# URL pubblico: usato da metadata, canonical, robots.txt e sitemap.
NEXT_PUBLIC_SITE_URL=https://naka-paga-in-crypto.onrender.com

# Override del periodo di gara (demo/staging). In produzione lasciare vuoti
# e usare le date in lib/constants.js.
NEXT_PUBLIC_CONTEST_VALID_FROM=
NEXT_PUBLIC_CONTEST_VALID_TO=

# Cartella dei dati locali (giocate, scontrini, outbox email).
DATA_DIR=

# Provider email: finché è vuoto le email vengono scritte in .data/outbox invece di essere spedite.
# Con la chiave configurata l'invio è reale (endpoint compatibile Resend).
MAIL_PROVIDER_API_KEY=
MAIL_FROM="NAKA <assistenza@naka.com>"
MAIL_PROVIDER_ENDPOINT=https://api.resend.com/emails

# Area rilevazioni (/rilevazioni), interna ai rilevatori sul campo.
# Un PIN per persona: il nome non si digita, lo deduce il server dal PIN, così
# «chi ha fatto questa visita» non dipende da chi se lo ricorda di scrivere.
# Esempio:  RILEVAZIONI_OPERATORI="Anna Rossi:4821,Luca Bianchi:7390"
RILEVAZIONI_OPERATORI=

# Alternativa senza identità: un codice condiviso, e il nome torna a essere un campo.
# Se entrambe sono vuote l'area è APERTA a chiunque conosca l'indirizzo.
RILEVAZIONI_CODE=
# Chiave fissa per firmare le sessioni (una stringa casuale lunga): senza, ogni modifica ai PIN disconnette tutti.
RILEVAZIONI_SECRET=
