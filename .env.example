# URL pubblico: usato da metadata, canonical, robots.txt e sitemap.
NEXT_PUBLIC_SITE_URL=https://concorso.naka.com

# Override del periodo di gara (demo/staging). In produzione lasciare vuoti
# e usare le date in lib/constants.js.
NEXT_PUBLIC_CONTEST_VALID_FROM=
NEXT_PUBLIC_CONTEST_VALID_TO=

# Cartella dei dati locali (giocate, scontrini, outbox email).
DATA_DIR=

# Provider email: finché è vuoto le email vengono scritte in .data/outbox invece di essere spedite.
# Con la chiave configurata l'invio è reale (endpoint compatibile Resend).
MAIL_PROVIDER_API_KEY=
MAIL_FROM="NAKA <contest@naka.com>"
MAIL_PROVIDER_ENDPOINT=https://api.resend.com/emails

# Area rilevazioni (/rilevazioni), interna ai rilevatori sul campo.
# Vuota = area aperta a chiunque abbia l'indirizzo: va impostata in produzione.
RILEVAZIONI_CODE=
